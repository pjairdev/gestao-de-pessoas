# Copie para .env.local e preencha com os dados do app Web do seu projeto Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > SDK setup and configuration)
# Sem estas variáveis o app abre em MODO DEMONSTRAÇÃO (dados só no navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3) — bloqueia chamadas ao banco que não venham do seu site.
# Console do Firebase > App Check > registrar app Web com reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=

# Só para desenvolvimento local com App Check ligado (gera token de debug no console do navegador)
VITE_APPCHECK_DEBUG=false
